{
	"name": "scheduler",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "ORIGIN=http://localhost PUBLIC_GIT_SHA=$(git rev-parse --verify HEAD) PUBLIC_GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) PUBLIC_VERSION=$npm_package_version PUBLIC_BUILD_DATE=$(date) PUBLIC_GIT_REMOTE=$(git ls-remote --get-url) vite dev",
		"build": "PUBLIC_GIT_SHA=$(git rev-parse --verify HEAD) PUBLIC_GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) PUBLIC_VERSION=$npm_package_version PUBLIC_BUILD_DATE=$(date) PUBLIC_GIT_REMOTE=$(git ls-remote --get-url) vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@eslint/js": "^9.26.0",
		"@playwright/test": "^1.52.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.20.8",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@types/eslint": "^9.6.1",
		"@types/nprogress": "^0.2.3",
		"@types/sortablejs": "^1.15.8",
		"@typescript-eslint/eslint-plugin": "^8.32.0",
		"@typescript-eslint/parser": "^8.32.0",
		"bits-ui": "^1.4.7",
		"clsx": "^2.1.1",
		"eslint": "^9.26.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.5.1",
		"formsnap": "^2.0.1",
		"globals": "^16.1.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.28.2",
		"svelte-check": "^4.1.7",
		"svelte-eslint-parser": "^1.1.3",
		"sveltekit-superforms": "^2.25.0",
		"tailwind-merge": "^3.2.0",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.1.5",
		"tslib": "^2.8.1",
		"typescript": "^5.8.3",
		"vite": "^6.3.5",
		"vitest": "^3.1.3",
		"zod": "^3.24.4"
	},
	"type": "module",
	"dependencies": {
		"@sonderbase/svelte-sortablejs": "^2.0.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.1.5",
		"argon2": "^0.43.0",
		"dayjs": "^1.11.13",
		"is-valid-domain": "^0.1.6",
		"lucide-svelte": "^0.508.0",
		"mode-watcher": "^1.0.7",
		"mongoose": "^8.14.2",
		"nprogress": "^0.2.0",
		"sortablejs": "^1.15.6",
		"svelte-dnd-action": "^0.9.61",
		"svelte-multiselect": "^11.0.0-rc.1",
		"tailwindcss-animate": "^1.0.7"
	}
}
