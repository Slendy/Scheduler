{
	"name": "scheduler",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "ORIGIN=http://localhost PUBLIC_GIT_SHA=$(git rev-parse --verify HEAD) PUBLIC_GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) PUBLIC_VERSION=$npm_package_version PUBLIC_BUILD_DATE=$(date) PUBLIC_GIT_REMOTE=$(git ls-remote --get-url) vite dev",
		"build": "PUBLIC_GIT_SHA=$(git rev-parse --verify HEAD) PUBLIC_GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) PUBLIC_VERSION=$npm_package_version PUBLIC_BUILD_DATE=$(date) PUBLIC_GIT_REMOTE=$(git ls-remote --get-url) vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@internationalized/date": "^3.7.0",
		"@playwright/test": "^1.50.1",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.17.1",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@types/bun": "^1.2.2",
		"@types/eslint": "^8.56.12",
		"@types/nprogress": "^0.2.3",
		"@types/sortablejs": "^1.15.8",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"bits-ui": "^1.0.0-next.94",
		"clsx": "^2.1.1",
		"embla-carousel-svelte": "^8.5.2",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"formsnap": "^2.0.0",
		"paneforge": "^1.0.0-next.2",
		"prettier": "^3.5.0",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "5.19.9",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^4.1.4",
		"svelte-sonner": "^0.3.28",
		"sveltekit-superforms": "^2.23.1",
		"tailwind-merge": "^2.6.0",
		"tailwind-variants": "^0.3.1",
		"tailwindcss": "^4.0.6",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"vaul-svelte": "^1.0.0-next.3",
		"vite": "^5.4.14",
		"vitest": "^1.6.1",
		"zod": "^3.24.1"
	},
	"type": "module",
	"dependencies": {
		"@sonderbase/svelte-sortablejs": "^2.0.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.16",
		"@tailwindcss/vite": "^4.0.6",
		"dayjs": "^1.11.13",
		"is-valid-domain": "^0.1.6",
		"lucide-svelte": "^0.474.0",
		"mode-watcher": "^0.5.1",
		"mongoose": "^8.10.0",
		"nprogress": "^0.2.0",
		"sortablejs": "^1.15.6",
		"svelte-dnd-action": "^0.9.57",
		"svelte-multiselect": "^10.3.0",
		"svelte-radix": "^2.0.1",
		"tailwindcss-animate": "^1.0.7"
	}
}
