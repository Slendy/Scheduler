{
	"name": "scheduler",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "ORIGIN=http://localhost PUBLIC_GIT_SHA=$(git rev-parse --verify HEAD) PUBLIC_GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) PUBLIC_VERSION=$npm_package_version PUBLIC_BUILD_DATE=$(date) PUBLIC_GIT_REMOTE=$(git ls-remote --get-url) vite dev",
		"build": "PUBLIC_GIT_SHA=$(git rev-parse --verify HEAD) PUBLIC_GIT_BRANCH=$(git rev-parse --abbrev-ref HEAD) PUBLIC_VERSION=$npm_package_version PUBLIC_BUILD_DATE=$(date) PUBLIC_GIT_REMOTE=$(git ls-remote --get-url) vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test",
		"test:unit": "vitest"
	},
	"devDependencies": {
		"@playwright/test": "^1.49.1",
		"@sveltejs/adapter-auto": "^3.3.1",
		"@sveltejs/kit": "^2.15.2",
		"@sveltejs/vite-plugin-svelte": "^4.0.4",
		"@types/bun": "^1.1.16",
		"@types/eslint": "^8.56.12",
		"@types/nprogress": "^0.2.3",
		"@types/sortablejs": "^1.15.8",
		"@typescript-eslint/eslint-plugin": "^7.18.0",
		"@typescript-eslint/parser": "^7.18.0",
		"autoprefixer": "^10.4.20",
		"bits-ui": "^1.0.0-next.77",
		"clsx": "^2.1.1",
		"eslint": "^8.57.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.46.1",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.2",
		"prettier-plugin-tailwindcss": "^0.6.5",
		"svelte": "^5.17.3",
		"svelte-adapter-bun": "^0.5.2",
		"svelte-check": "^3.8.6",
		"tailwind-merge": "^2.6.0",
		"tailwind-variants": "^0.3.0",
		"tailwindcss": "^3.4.9",
		"tslib": "^2.8.1",
		"typescript": "^5.7.3",
		"vite": "^5.4.11",
		"vitest": "^1.6.0"
	},
	"type": "module",
	"dependencies": {
		"@sonderbase/svelte-sortablejs": "^2.0.2",
		"@tailwindcss/container-queries": "^0.1.1",
		"@tailwindcss/forms": "^0.5.9",
		"@tailwindcss/typography": "^0.5.15",
		"dayjs": "^1.11.13",
		"is-valid-domain": "^0.1.6",
		"lucide-svelte": "^0.471.0",
		"mode-watcher": "^0.5.0",
		"mongoose": "^8.9.4",
		"nprogress": "^0.2.0",
		"sortablejs": "^1.15.6",
		"svelte-dnd-action": "^0.9.54",
		"svelte-multiselect": "^10.3.0",
		"tailwindcss-animate": "^1.0.7"
	}
}
